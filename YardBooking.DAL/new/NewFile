using Microsoft.Extensions.DependencyInjection;
using YardBooking.BLL.IServices;
using YardBooking.BLL.Services;
using YardBooking.DAL.Interfaces;
using YardBooking.DAL.Repository;

namespace YardBooking.API
{
    public static class ServiceRegistration
    {
        public static void AddYardBookingServices(this IServiceCollection services)
        {
            // Register repositories
            services.AddScoped<IYardOwnerRepository, YardOwnerRepository>();
            
            // Register services
            services.AddScoped<IYardOwnerService, YardOwnerService>();
            
            // Additional registrations for other services would be here
        }
    }
}