@{
}
@model FrontEnd.Models.RegisterViewModel
@{
}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: system-ui, -apple-system, sans-serif;
    }

    body {
        background-color: #f3f4f6;
    }

    .container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .form-container {
        background-color: white;
        padding: 2rem;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        width: 450px;
        max-width: 28rem;
    }

    .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .logo-circle {
        background-color: #22c55e;
        color: white;
        padding: 0.5rem;
        border-radius: 50%;
        margin-right: 0.75rem;
    }

    .logo h1 {
        font-size: 1.875rem;
        font-weight: bold;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.5rem;
        }

    .input-container {
        position: relative;
    }

        .input-container input,
        .input-container select {
            width: 100%;
            padding: 0.5rem 0.75rem;
            padding-right: 2.5rem;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .input-container input:focus,
            .input-container select:focus {
                border-color: #22c55e;
                box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
            }

        .input-container .icon {
            position: absolute;
            right: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

    .radio-group {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .radio-option {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .submit-btn {
        width: 100%;
        background-color: #22c55e;
        color: white;
        padding: 0.625rem;
        border: none;
        border-radius: 0.375rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .submit-btn:hover {
            background-color: #16a34a;
        }

    .divider {
        margin: 1.5rem 0;
        border-top: 1px solid #e5e7eb;
    }

    .social-buttons {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .social-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 0.625rem;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        background-color: white;
        color: #4b5563;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .social-btn:hover {
            background-color: #f9fafb;
        }

        .social-btn svg {
            margin-right: 0.5rem;
        }

    .login-link {
        margin-top: 1.5rem;
        text-align: center;
        color: #4b5563;
    }

        .login-link a {
            color: #22c55e;
            font-weight: 500;
            text-decoration: none;
        }

    .login-link a:hover {
        text-decoration: underline;
    }

    .validation-message {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    .input-error {
        border-color: #dc2626 !important;
    }

        .input-error:focus {
            box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.2) !important;
        }
</style>

<div class="container">
    <div class="form-container">
        <div class="logo">
            <span class="material-symbols-outlined">
                sports_soccer
            </span>
            <p>Football Yard</p>
        </div>

        <form asp-controller="Auth" asp-action="Register" method="post">
            <!-- Show success message if available -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div class="form-group">
                <label asp-for="Name">Full Name</label>
                <div class="input-container">
                    <input asp-for="Name" type="text" placeholder="Full Name" class="@(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <span asp-validation-for="Name" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <div class="input-container">
                    <input asp-for="Email" type="email" placeholder="Email" class="@(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z">
                        </path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </div>
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <div class="input-container">
                    <input asp-for="Password" type="password" placeholder="Password" class="@(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <div class="input-container">
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" class="@(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gender">Gender</label>
                <div class="radio-group">
                    <div class="radio-option">
                        <input asp-for="Gender" type="radio" id="male" value="male" />
                        <label for="male">Male</label>
                    </div>
                    <div class="radio-option">
                        <input asp-for="Gender" type="radio" id="female" value="female" />
                        <label for="female">Female</label>
                    </div>
                </div>
                <span asp-validation-for="Gender" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="DateOfBirth">Date of Birth</label>
                <div class="input-container">
                    <input asp-for="DateOfBirth" type="date" class="@(ViewData.ModelState["DateOfBirth"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <span asp-validation-for="DateOfBirth" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="IDNumber">National ID</label>
                <div class="input-container">
                    <input asp-for="IDNumber" type="text" placeholder="National ID" class="@(ViewData.ModelState["IDNumber"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Card body -->
                        <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
                        <!-- Divider line -->
                        <line x1="2" y1="10" x2="22" y2="10"></line>
                        <!-- Card number/chip area -->
                        <line x1="6" y1="15" x2="8" y2="15"></line>
                        <line x1="10" y1="15" x2="14" y2="15"></line>
                    </svg>
                </div>
                <span asp-validation-for="IDNumber" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">Phone</label>
                <div class="input-container">
                    <input asp-for="PhoneNumber" type="tel" placeholder="Phone Number" class="@(ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                </div>
                <span asp-validation-for="PhoneNumber" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Location">Location</label>
                <div class="input-container">
                    <input asp-for="Location" type="text" placeholder="Your Location" class="@(ViewData.ModelState["Location"]?.Errors.Count > 0 ? "input-error" : "")" />
                    <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <span asp-validation-for="Location" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role">Role</label>
                <div class="input-container">
                    <select asp-for="Role" class="@(ViewData.ModelState["Role"]?.Errors.Count > 0 ? "input-error" : "")">
                        <option value="@UserRole.User">Player</option>
                        <option value="@UserRole.Owner">Owner</option>
                    </select>
                </div>
                <span asp-validation-for="Role" class="validation-message"></span>
            </div>

            <!-- Display general validation errors -->
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>

            <button type="submit" class="submit-btn">Register</button>
        </form>

        <div class="divider"></div>

        <div class="login-link">
            <p>Already have an account? <a asp-controller="Home" asp-action="Login">Log In</a></p>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}