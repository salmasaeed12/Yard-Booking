@{
}

<div class="land-container">
    <div class="landing">
        <div class="overlay"></div>
        <h1>Book a Football Yard </h1>
        <form action="">
            <input type="text" name="name" placeholder="Locattion" required>
            <input type="text" id="date" placeholder="Date" onfocus="(this.type='date')"
                   onblur="if(this.value==''){this.type='text'}">
            <input type="text" placeholder="Time" onfocus="this.type='time'"
                   onblur="if(this.value==''){this.type='text'}">
            <button>Search</button>
        </form>
    </div>
    <h2 class="title">Featured Yards</h2>
    <div class="featured-yards">
        <div class="yard">
            <img src="yard1.jpg" alt="">
            <div class="yard-info">
                <h2>Stadium One</h2>
                <p> <span>★</span>Sheikh Zayed</p>
                <span>$100 / h</span>
            </div>
            <a href=""><button>Book Now!</button></a>
        </div>
        <div class="yard">
            <img src="yard2.jpg" alt="">
            <div class="yard-info">
                <h2>Stadium Two</h2>
                <p> <span>★</span>Nasr City</p>
                <span>$85 / h</span>
            </div>
            <a href=""><button>Book Now!</button></a>

        </div>
        <div class="yard">
            <img src="yard3.jpg" alt="">
            <div class="yard-info">
                <h2>Stadium Three</h2>
                <p> <span>★</span>Maadi</p>
                <span>$90 / h</span>
            </div>
            <a href=""><button>Book Now!</button></a>

        </div>
        <div class="yard">
            <img src="yard2.jpg" alt="">
            <div class="yard-info">
                <h2>Stadium Four</h2>
                <p> <span>★</span>Helioplis</p>
                <span>$110 / h</span>
            </div>
            <a href=""><button>Book Now!</button></a>

        </div>
    </div>
    <div class="about">
        <div class="section">
            <h2>About</h2>
            <p>
                Football Yard Booking System is a platform that allows useres to easily book football feilds
                online.
            </p>
        </div>
        <div class="section">
            <h2>Our Mission</h2>
            <p>
                Our mission is to provide a convenient and efficient way for players to find and reserve football
                yards, promoting a healthy and active life style.
            </p>
        </div>
    </div>
    <div class="contact">
        <h2 class="title">Contact Us</h2>
        <form action="">
            <input type="text" name="" id="" placeholder="Name">
            <input type="email" name="" id="" placeholder="Email">
            <input type="text" name="" id="" placeholder="Message">
            <button>Send</button>
        </form>
    </div>
    <partial name="..\Shared/footer.cshtml"></partial>
</div>